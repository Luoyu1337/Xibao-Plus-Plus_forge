--- /dev/null
+++ b/Forge-1.20.1/build.gradle
@@ -0,0 +1,55 @@
+// ForgeGradle scaffold for Minecraft 1.20.1
+buildscript {
+    repositories {
+        mavenCentral()
+        maven { url = uri('https://maven.minecraftforge.net') }
+    }
+    dependencies {
+        // Please replace with the specific ForgeGradle coordinate if needed
+        classpath 'net.minecraftforge.gradle:ForgeGradle:5.1.+'
+    }
+}
+
+apply plugin: 'net.minecraftforge.gradle'
+apply plugin: 'maven-publish'
+
+group = 'top.gregtao'
+version = project.findProperty('mod_version') ?: '1.0.0'
+
+sourceCompatibility = JavaVersion.toVersion(javaVersion)
+targetCompatibility = JavaVersion.toVersion(javaVersion)
+
+minecraft {
+    // Use properties from gradle.properties — replace with concrete values if needed
+    mappings channel: project.findProperty('mappings_channel'), version: project.findProperty('mappings_version')
+    // Example: runs {
+    //   client {
+    //     workingDirectory project.file('run')
+    //   }
+    // }
+}
+
+repositories {
+    mavenCentral()
+    maven { url = uri('https://maven.minecraftforge.net') }
+}
+
+dependencies {
+    // Replace with concrete forge artifact, e.g. fg.deobf('net.minecraftforge:forge:1.20.1-45.1.0')
+    // implementation fg.deobf(project.findProperty('forge_version'))
+}
+
+tasks.withType(JavaCompile) {
+    options.encoding = 'UTF-8'
+}
+
+// This build file is scaffold: you must set forge_version (gradle.properties) to a real Forge coordinate
+// and ensure ForgeGradle/mappings versions match the desired Forge release before running ./gradlew build.
