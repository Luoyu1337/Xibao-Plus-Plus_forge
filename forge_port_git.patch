diff --git a/.github/workflows/forge-build.yml b/.github/workflows/forge-build.yml
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/.github/workflows/forge-build.yml
@@ -0,0 +1,30 @@
+name: Forge Build
+on:
+  push:
+    branches: [ "forge-1.20.1-port" ]
+  pull_request:
+    branches: [ main ]
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      packages: write
+      id-token: write
+    steps:
+      - uses: actions/checkout@v4
+      - name: Set up Java 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - name: Grant execute permission for gradlew
+        run: chmod +x gradlew || true
+      - name: Build
+        run: ./gradlew :Forge-1.20.1:build --no-daemon
+      - name: Upload artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: forge-jar
+          path: Forge-1.20.1/build/libs/*.jar
\ No newline at end of file

diff --git a/README.forge-migration.md b/README.forge-migration.md
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/README.forge-migration.md
@@ -0,0 +1,15 @@
+说明：此补丁为 Forge 移植骨架。使用方法：
+1) 在本地仓库根运行：
+   git checkout -b forge-1.20.1-port
+   # 将本目录下的 Forge-1.20.1 文件复制或直接把这些文件添加到仓库
+2) 根据注释替换 build.gradle 中的 ForgeGradle/mappings/forge 具体版本号
+3) 在项目根运行 gradle wrapper（如果未包含 wrapper）：
+   gradle wrapper --gradle-version 8.3
+4) 运行 ./gradlew :Forge-1.20.1:build
+
+注意：mixins 需要把目标名从 Yarn 映射调整为 Mojmap 名称；Fabric API 依赖需替换或实现兼容逻辑。
+
\ No newline at end of file
